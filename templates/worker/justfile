set shell := ["bash", "-cu"]

run:
	uv sync --extra dev
	SECRET_KEY="${SECRET_KEY:-dev-only-not-for-production}" ENV="${ENV:-development}" uv run python -m app.main

test:
	uv sync --extra dev
	SECRET_KEY="${SECRET_KEY:-test-only-not-secret}" ENV=test uv run pytest

docker:
	docker build -t {{ project_name }}:local .
